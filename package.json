{
  "name": "claude-bridge",
  "displayName": "ClaudeBridge · 渡桥",
  "description": "ClaudeBridge（渡桥）：通过本地 DevSpace MCP 与 SSH 反向隧道连接远程服务器上的 Claude Code，代码留在本地、AI 流量留在远程，提供侧边栏 Agent 面板、可视化设置中心与规则记忆管理。",
  "version": "0.6.0",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-bridge-sidebar",
          "title": "ClaudeBridge · 渡桥",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claude-bridge-sidebar": [
        {
          "type": "webview",
          "id": "claudeBridge.chatView",
          "name": "渡桥 Claude"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeBridge.connect",
        "title": "ClaudeBridge: 一键连接 / 重连",
        "icon": "$(plug)"
      },
      {
        "command": "claudeBridge.disconnect",
        "title": "ClaudeBridge: 断开连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "claudeBridge.openChat",
        "title": "ClaudeBridge: 打开聊天面板"
      },
      {
        "command": "claudeBridge.openTerminal",
        "title": "ClaudeBridge: 打开原生远程终端",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeBridge.sendSelection",
        "title": "ClaudeBridge: 将选中代码发送到聊天"
      },
      {
        "command": "claudeBridge.addCurrentFile",
        "title": "ClaudeBridge: 引用当前文件到聊天"
      },
      {
        "command": "claudeBridge.showMenu",
        "title": "ClaudeBridge: 快捷操作菜单"
      },
      {
        "command": "claudeBridge.showLogs",
        "title": "ClaudeBridge: 查看实时输出面板"
      },
      {
        "command": "claudeBridge.openLogFile",
        "title": "ClaudeBridge: 打开诊断日志文件 (bridge.log)"
      },
      {
        "command": "claudeBridge.openSettings",
        "title": "ClaudeBridge: 打开可视化设置中心",
        "icon": "$(gear)"
      },
      {
        "command": "claudeBridge.openSetupWizard",
        "title": "ClaudeBridge: 打开新机配置向导",
        "icon": "$(rocket)"
      },
      {
        "command": "claudeBridge.openLocalRules",
        "title": "ClaudeBridge: 打开本地 CLAUDE.md"
      },
      {
        "command": "claudeBridge.syncRules",
        "title": "ClaudeBridge: 同步本地 CLAUDE.md 到远程",
        "icon": "$(sync)"
      },
      {
        "command": "claudeBridge.viewRemoteMemories",
        "title": "ClaudeBridge: 拉取并查看远程 Claude 记忆"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "claudeBridge.sendSelection",
          "when": "editorHasSelection",
          "group": "claudeBridge@1"
        },
        {
          "command": "claudeBridge.addCurrentFile",
          "when": "editorTextFocus",
          "group": "claudeBridge@2"
        }
      ]
    },
    "configuration": {
      "title": "ClaudeBridge · 渡桥",
      "properties": {
        "claudeBridge.sshHost": {
          "type": "string",
          "default": "",
          "description": "远程服务器公网 IP 或域名（例如 1.2.3.4）"
        },
        "claudeBridge.sshUser": {
          "type": "string",
          "default": "ubuntu",
          "description": "远程服务器 SSH 登录用户名"
        },
        "claudeBridge.sshPort": {
          "type": "number",
          "default": 22,
          "description": "远程服务器 SSH 端口"
        },
        "claudeBridge.sshKeyPath": {
          "type": "string",
          "default": "",
          "description": "本地 SSH 私钥 (.pem) 绝对路径（例如 ~/.ssh/my-server.pem）"
        },
        "claudeBridge.sshProxy": {
          "type": "string",
          "default": "auto",
          "description": "SSH 代理策略：auto（自动跟随环境变量代理，无代理则直连）、off（强制直连），或手动填代理地址如 http://127.0.0.1:8080"
        },
        "claudeBridge.localPort": {
          "type": "number",
          "default": 7676,
          "description": "本地 DevSpace MCP 监听端口"
        },
        "claudeBridge.remotePort": {
          "type": "number",
          "default": 7676,
          "description": "远程服务器映射的回环端口"
        },
        "claudeBridge.devspacePath": {
          "type": "string",
          "default": "",
          "description": "本地 devspace 可执行文件路径（留空则自动从 PATH 与 nvm 查找）"
        },
        "claudeBridge.remoteClaudePath": {
          "type": "string",
          "default": "claude",
          "description": "远程服务器上 claude CLI 命令或绝对路径"
        },
        "claudeBridge.permissionMode": {
          "type": "string",
          "enum": [
            "bypassPermissions",
            "acceptEdits",
            "plan",
            "dontAsk"
          ],
          "enumDescriptions": [
            "全部允许：自动执行读写和命令（推荐，可配合 Git 随时撤回）",
            "自动改文件：自动放行编辑，危险命令受限",
            "只读规划：只分析代码与给方案，不修改任何文件",
            "严格限制：未预先授权的工具自动拒绝"
          ],
          "default": "bypassPermissions",
          "description": "远程 Claude Code 权限模式"
        },
        "claudeBridge.model": {
          "type": "string",
          "default": "",
          "description": "指定 Claude 模型名称（留空跟随远程默认）"
        },
        "claudeBridge.effort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "远程 Claude Code 思考强度 (--effort)"
        },
        "claudeBridge.chatTheme": {
          "type": "string",
          "enum": [
            "claude",
            "wechat",
            "feishu",
            "vscode"
          ],
          "enumDescriptions": [
            "Claude 风格：温润暖炭黑画布、陶土暖橙气泡与优雅文档排版",
            "微信风格：经典左灰右绿聊天双气泡与微信清爽 Markdown 样式",
            "飞书风格：飞书品牌蓝、深蓝灰画布与飞书云文档高亮块/表格排版",
            "跟随 VS Code：完全贴合当前编辑器原生主题配色"
          ],
          "default": "claude",
          "description": "聊天面板与设置中心的整套视觉主题（含 Markdown 排版样式）"
        },
        "claudeBridge.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "打开 VS Code 时自动启动本地 DevSpace 并建立 SSH 反向隧道"
        },
        "claudeBridge.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "隧道意外断开或电脑休眠唤醒后自动重连"
        },
        "claudeBridge.keepRunningOnClose": {
          "type": "boolean",
          "default": false,
          "description": "关闭 VS Code 窗口时是否保留由本插件启动的后台服务与隧道"
        },
        "claudeBridge.autoAttachWorkspaceContext": {
          "type": "boolean",
          "default": true,
          "description": "每次发消息时自动附带轻量工作区现场（工作区、活动文件与行号、Git 分支与改动，同一会话内无变化自动去重）"
        },
        "claudeBridge.syncLocalRules": {
          "type": "boolean",
          "default": false,
          "description": "连接远程成功时，自动将本地 CLAUDE.md 无损合并同步到远程 ~/.claude/CLAUDE.md"
        },
        "claudeBridge.syncLocalSkills": {
          "type": "boolean",
          "default": true,
          "description": "连接或切换 VPS 时，自动按内容指纹增量同步本机 ~/.claude/skills/ 到远程 ~/.claude/skills/"
        },
        "claudeBridge.localClaudeMdPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.claude/CLAUDE.md"
          ],
          "description": "需要同步到远程的本地规则文件路径列表"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && npm run build && npx @vscode/vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.4.0",
    "esbuild": "^0.25.0",
    "marked": "^15.0.0",
    "typescript": "^5.8.0"
  }
}
